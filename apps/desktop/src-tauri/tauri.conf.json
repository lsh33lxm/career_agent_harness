{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Career Harness",
  "version": "0.1.0",
  "identifier": "com.minnn.agent-career-harness",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/agent-career-harness-sidecar"],
    "resources": {
      "../../../third_party_licenses/REPORTLAB-LICENSE.txt": "licenses/REPORTLAB-LICENSE.txt"
    }
  }
}
